# Frontend environment — copy to .env.local and fill in (never commit values)
# Base URL of the Express backend (used by the /api/v1/* dev rewrite proxy).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public origin used for canonical URLs, OG tags, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://telal-contracting.com
# Google reCAPTCHA site key (public value; pairs with backend RECAPTCHA_SECRET).
# For localhost dev use Google's public test site key
# 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI (works on any domain, always passes
# verification) — see docs/04-environment-setup.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=