# Backend environment — copy to .env and fill in real values locally (never commit)
# Values are intentionally blank/placeholder; this file is the committed reference.

# Server
PORT=4000
NODE_ENV=development

# MySQL (Prisma) — app DB user, never root.
DATABASE_URL=mysql://telal:<password>@127.0.0.1:3301/telalalqema

# CORS allowlist for the Next.js frontend (comma-separated).
CORS_ORIGIN=http://localhost:3000

# Initial admin account created by `npm run seed` (first run only). Never commit real values.
ADMIN_SEED_EMAIL=admin@telal-contracting.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-dev-password

# Auth (M2)
# JWT_SECRET=replace-with-a-long-random-string

# SMTP (M3)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# Google reCAPTCHA (M3)
# RECAPTCHA_SITEKEY=your-site-key
# RECAPTCHA_SECRET=your-secret-key