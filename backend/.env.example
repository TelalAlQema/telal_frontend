# Backend environment — copy to .env and fill in real values locally (never commit)
# Values are intentionally blank; this file is the committed reference.

# Server
PORT=4000
NODE_ENV=development

# MySQL (Prisma connection string — M1)
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/telalalqema

# Auth (M2)
# JWT_SECRET=replace-with-a-long-random-string

# SMTP (M3)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# Google reCAPTCHA (M3)
# RECAPTCHA_SITEKEY=your-site-key
# RECAPTCHA_SECRET=your-secret-key